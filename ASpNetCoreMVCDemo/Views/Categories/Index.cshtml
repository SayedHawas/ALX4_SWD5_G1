@model IEnumerable<ASpNetCoreMVCDemo.Models.Category>

<h2> List Of Category</h2>

<a href="Categories/Create" class="btn btn-primary"> Create </a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryId</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    @* HTML Helper *@
                    @Html.ActionLink("Edit","Edit",new{id = item.CategoryId})

                    @* Tag Helper*@

                   @*  <a asp-controller="Categories" asp-action="Edit" class="btn btn-primary"> Edit </a> | *@
                   
                    @* <a asp-action="" asp-controller="" ></a> *@

                    @* <a href="Categories/Edit/@item.CategoryId" class="btn btn-primary" > Edit </a> |
                    <a href="Categories/Details" class="btn btn-success"> Details </a>|
                    <a href="Categories/Delete" class="btn btn-danger"> Delete </a> *@ 

                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger">Delete</a>

                </td>
            </tr>
        }
    </tbody>
</table>
  
